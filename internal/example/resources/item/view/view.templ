package view

import (
	"strconv"

	"github.com/AranjuezY/saas-template/internal/example/resources/item/port"
	"github.com/AranjuezY/saas-template/internal/shared/ui"
)

// Page 是条目列表的完整页面（view 自带整页；无跨资源组装时不需要 pages 层）。
templ Page(list []port.Item) {
	@ui.Base("Items · saas-template") {
		<div class="mb-4">
			<h1 class="text-2xl font-bold">Items</h1>
			<p class="mt-1 text-sm opacity-60">示例域：item 生命周期——激活后 7 天有效，到期自动归档，可续期或提前归档</p>
		</div>
		<div class="grid items-start gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
			@Form()
			<div class="card bg-base-100 shadow-sm">
				<div class="card-body p-0">
					<div class="overflow-x-auto">
						<table class="table table-zebra">
							<thead>
								<tr>
									<th>标题</th>
									<th>阶段</th>
									<th>到期</th>
									<th>创建时间</th>
									<th class="text-right">操作</th>
								</tr>
							</thead>
							<tbody id="item-rows">
								@Rows(list)
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	}
}

// Rows 是列表片段：整页与 htmx 局部刷新共用（双用途片段）。
templ Rows(list []port.Item) {
	if len(list) == 0 {
		<tr>
			<td colspan="5">
				@ui.EmptyState("还没有条目", "在左侧添加一个")
			</td>
		</tr>
	} else {
		for _, i := range list {
			@Row(i)
		}
	}
}

// Row 单行条目记录。启用 / 续期 / 归档在服务端分别映射为对生命周期
// 流程的三个更新（Update 同步返回新快照），不会绕过 Temporal 直接改库。
templ Row(i port.Item) {
	<tr id={ "item-" + strconv.FormatInt(i.ID, 10) } class="hover:bg-base-200/60">
		<td class="font-medium">{ i.Title }</td>
		<td><span class={ StageBadgeClass(i.Stage) }>{ StageLabel(i.Stage) }</span></td>
		<td>
			if i.Stage == port.StageActive && i.ExpiresAt != nil {
				<span class={ ExpiryBadgeClass(i) }>{ ExpiryLabel(i) }</span>
			}
		</td>
		<td class="whitespace-nowrap text-xs opacity-60">{ ui.FormatTime(i.CreatedAt) }</td>
		<td class="text-right">
			<div class="flex justify-end gap-1">
				if i.Stage == port.StageDraft {
					<button
						class="btn btn-primary btn-xs"
						type="button"
						hx-post={ "/items/" + strconv.FormatInt(i.ID, 10) + "/activate" }
						hx-target="closest tr"
						hx-swap="outerHTML"
					>
						启用
					</button>
				}
				if i.Stage == port.StageActive {
					<button
						class="btn btn-outline btn-xs"
						type="button"
						hx-post={ "/items/" + strconv.FormatInt(i.ID, 10) + "/renew" }
						hx-target="closest tr"
						hx-swap="outerHTML"
					>
						续期 7 天
					</button>
					<button
						class="btn btn-ghost btn-xs"
						type="button"
						hx-post={ "/items/" + strconv.FormatInt(i.ID, 10) + "/archive" }
						hx-target="closest tr"
						hx-swap="outerHTML"
						hx-confirm={ "确定归档 " + i.Title + " 吗？" }
					>
						归档
					</button>
				}
				<button
					class="btn btn-ghost btn-xs text-error"
					type="button"
					hx-delete={ "/items/" + strconv.FormatInt(i.ID, 10) }
					hx-target="closest tr"
					hx-swap="outerHTML swap:150ms"
					hx-confirm={ "确定删除 " + i.Title + " 吗？（生命周期流程将一并结束）" }
				>
					删除
				</button>
			</div>
		</td>
	</tr>
}

// NotFoundPage 404 页面。
templ NotFoundPage() {
	@ui.Base("页面不存在 · saas-template") {
		<div class="flex flex-col items-center gap-3 py-24 text-center">
			<p class="text-5xl font-bold opacity-20">404</p>
			<p class="font-medium">找不到这个页面</p>
			<a class="btn btn-primary btn-sm" href="/">回到列表</a>
		</div>
	}
}

// Form 新增条目表单，通过 htmx 提交。
templ Form() {
	@ui.Card("新增条目") {
		<form
			id="create-form"
			class="flex flex-col gap-3"
			hx-post="/items"
			hx-target="#item-rows"
			hx-swap="innerHTML"
			hx-indicator="#create-spinner"
			data-reset-on-success
		>
			<label class="form-control">
				<div class="label py-1"><span class="label-text">标题 <span class="text-error">*</span></span></div>
				<input
					class="input input-bordered input-sm w-full"
					type="text"
					name="title"
					required
					maxlength="128"
					placeholder="做什么"
				/>
			</label>
			<div class="flex items-center gap-2">
				<button class="btn btn-primary btn-sm" type="submit">
					@ui.Spinner("create-spinner")
					添加
				</button>
				<button class="btn btn-ghost btn-sm" type="reset">清空</button>
			</div>
		</form>
	}
}
